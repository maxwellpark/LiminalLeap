# 1Password references, not secrets: op resolves them into the child process only.
#
# Create the item once:
#   op item create --category="API Credential" --vault=LiminalLeap --title=itch \
#     api-key="<key from https://itch.io/user/settings/api-keys>"
#
# Then check the reference resolves without ever printing it:
#   scripts/deploy-itch.sh --check
BUTLER_API_KEY=op://LiminalLeap/itch/api-key

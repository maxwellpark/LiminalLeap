# 1Password references, not secrets: op resolves them into the child process only.
#
# Use a Unity ID made for automation, not a personal one, so it can be revoked on its own:
#   op item create --category=Login --vault=LiminalLeap --title=unity \
#     username="<that account's email>" password="<its password>"
#
# Then check the references resolve without ever printing them:
#   scripts/unity-activate.sh --check
UNITY_EMAIL=op://LiminalLeap/unity/username
UNITY_PASSWORD=op://LiminalLeap/unity/password

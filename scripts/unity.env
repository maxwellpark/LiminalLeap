# 1Password secret references for activating Unity, not secrets. Safe to commit, like
# itch.env: op resolves them at run time into the child process only.
#
# Use a Unity ID made for automation, not your own, so it can be revoked on its own.
# Create the item once, in the vault the service account reads:
#   op item create --category=Login --vault=Deploy --title="Unity CI" \
#     username="<that account's email>" password="<its password>"
#
# Then check the references resolve without ever printing them:
#   scripts/unity-activate.sh --check
UNITY_EMAIL=op://Deploy/Unity CI/username
UNITY_PASSWORD=op://Deploy/Unity CI/password

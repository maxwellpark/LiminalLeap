# 1Password secret references, not secrets. Safe to commit: this names where the value
# lives, and op resolves it at run time into the child process only.
#
# Create the item once:
#   op item create --category="API Credential" --vault=Deploy --title="itch butler" \
#     credential="<key from https://itch.io/user/settings/api-keys>"
#
# Then check the reference resolves without ever printing it:
#   scripts/deploy-itch.sh --check
BUTLER_API_KEY=op://Deploy/itch butler/credential
